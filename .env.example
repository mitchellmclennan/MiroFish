# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here
# Zep 集成模式（可选）：cloud=Zep Cloud（默认，使用官方 Batch API）；
# local=本地 OpenZep 服务（使用 /graph-batch 直传路径）
# 注意：local模式下图谱检索（人设 grounding 与报告搜索）会直传本地
# 契约 /graph/search 并以 session_id=<graph_id> 限定检索范围——本地
# OpenZep 会忽略 SDK 的 graph_id/scope 参数，不限定范围时会跨服务器上
# 所有图谱检索，污染新图人设；cloud模式完全不受影响。
# ZEP_MODE=local
# Zep API 端点（可选）：默认 https://api.getzep.com/api/v2
# 注意：ZEP_MODE=local 时必须显式指定本地服务地址，例如：
# ZEP_BASE_URL=http://localhost:8000/api/v2

# ===== 运行级语言与实体质量过滤（可选） =====
# MIROFISH_LLM_LANGUAGE：整条流水线（本体/人设/动作/报告）强制使用指定
# 语言的 LLM 输出。目前仅支持 "en"（区域变体如 en-US/en_US 会归一化为
# en）；设置为其他语言会被忽略并告警（其他语言没有完整的模板支持，
# 会产生混合语言输出）。未设置时按请求 locale（默认中文）。
# MIROFISH_LLM_LANGUAGE=en
# MIROFISH_ENTITY_QUALITY_FILTER：人设生成前的垃圾实体质量过滤（法规、
# 错标产品/公司、定价套餐档位、样板碎片等），默认开启；
# 设为 0/false/off/no 关闭。剔除/重标原因写入模拟目录的
# entity_quality_report.json 供人工审计。
# MIROFISH_ENTITY_QUALITY_FILTER=1

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
